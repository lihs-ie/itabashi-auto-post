{
  "name": "itabashi-auto-post",
  "displayName": "Itabashi auto post",
  "version": "1.0.0",
  "description": "ニコ生配信開始ポスト自動化",
  "author": "lihs-dev",
  "scripts": {
    "dev": "plasmo dev",
    "after-build:dev": "NODE_ENV=development node ./after-build/add-redirect-uri.js",
    "after-build:prd": "NODE_ENV=production node ./after-build/add-redirect-uri.js",
    "build:dev": "NODE_ENV=development plasmo build --tag=dev && pnpm run after-build:dev",
    "build:prd": "NODE_ENV=production plasmo build --tag=production --zip && pnpm run after-build:prd",
    "package": "plasmo package",
    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "classnames": "^2.5.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "http-errors": "^2.0.1",
    "immutable": "^5.1.5",
    "inversify": "^6.2.2",
    "js-sha256": "^0.11.1",
    "plasmo": "0.90.5",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.18",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "chrome": "link:@types/@types/chrome",
    "eslint": "^9.19.0",
    "eslint-plugin-storybook": "^0.11",
    "prettier": "3.8.3",
    "sass": "^1.99.0",
    "storybook": "^8.6.18",
    "typescript": "5.9.3",
    "uuid": "^11.0.5",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^5",
    "vitest": "^4.1.5",
    "vitest-fetch-mock": "^0.4.5"
  },
  "manifest": {
    "host_permissions": [
      "$PLASMO_PUBLIC_ITABASHI_AUTO_POST_GAS_API_ENDPOINT/*",
      "$PLASMO_PUBLIC_ITABASHI_AUTO_POST_GAS_API_REDIRECT_URI/*"
    ],
    "key": "$EXTENSION_KEY",
    "oauth2": {
      "client_id": "$PLASMO_PUBLIC_OAUTH_CLIENT_ID",
      "scopes": [
        "tweet.write",
        "tweet.read",
        "users.read"
      ]
    },
    "externally_connectable": {
      "matches": [
        "https://live.nicovideo.jp/watch/lv*"
      ]
    },
    "permissions": [
      "storage",
      "identity",
      "scripting",
      "alarms",
      "notifications"
    ]
  }
}
